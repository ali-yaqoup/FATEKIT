// ============================================================
// FATEKIT — Prisma Schema
// Postgres (hosted on Supabase). Currency is always ₪ (ILS).
// Payment method is cash-on-delivery only — no payment gateway
// tables/fields are modeled on purpose.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  NEW // جديد
  PROCESSING // قيد التجهيز
  SHIPPED // تم الشحن
  DELIVERED // تم التوصيل
  CANCELLED // ملغي
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum AdminRole {
  OWNER
  STAFF
}

// ------------------------------------------------------------
// CATEGORY (self-referencing → gives Category + Subcategory
// out of one table: parentId = null → top-level category,
// parentId set → subcategory of that category)
// ------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  imageUrl  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  parentId String?
  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryToSubcategory")

  products         Product[]
  featuredEntries  FeaturedCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// ------------------------------------------------------------
// PRODUCT
// ------------------------------------------------------------

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  brand       String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Pricing — always ₪
  price            Decimal @db.Decimal(10, 2)
  compareAtPrice   Decimal? @db.Decimal(10, 2) // السعر قبل الخصم
  discountPercent  Int?

  // Inventory used only when the product has NO variants.
  // If variants exist, stock is tracked per-variant instead.
  sku      String? @unique
  quantity Int?    @default(0)

  ingredients        String? @db.Text // المكونات
  usageInstructions  String? @db.Text // طريقة الاستخدام
  details            String? @db.Text // تفاصيل إضافية

  status      ProductStatus @default(ACTIVE)
  isFeatured  Boolean       @default(false)
  isNew       Boolean       @default(false)
  isBestseller Boolean      @default(false)

  // Soft delete — never hard-delete a product referenced by past orders
  isArchived Boolean @default(false)

  images   ProductImage[]
  variants ProductVariant[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

// Shade / variant — e.g. "01 Nude", "02 Rose"
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name      String  // اسم الدرجة، مثال: "01 Nude"
  colorCode String? // كود اللون (hex)
  imageUrl  String?

  price    Decimal? @db.Decimal(10, 2) // override اختياري، إذا فاضي يستخدم سعر المنتج الأساسي
  sku      String?  @unique
  quantity Int      @default(0)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// CUSTOMER
// ------------------------------------------------------------

model Customer {
  id    String @id @default(cuid())
  name  String
  phone String  @unique
  email String? @unique

  // Denormalized for fast admin list rendering; recompute on order write
  ordersCount Int      @default(0)
  totalSpent  Decimal  @default(0) @db.Decimal(10, 2)
  lastOrderAt DateTime?

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// ORDER
// ------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique // e.g. "FK-1024"
  status      OrderStatus @default(NEW)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Shipping snapshot (captured at order time)
  shippingAddress String
  shippingCity    String
  deliveryNotes   String?

  // Totals — always ₪. Payment is always COD, so no payment fields beyond a label.
  subtotal    Decimal @db.Decimal(10, 2)
  shippingFee Decimal @default(0) @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  paymentMethod String @default("COD") // ثابتة، لا تتغيّر — الدفع عند الاستلام فقط

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
}

// Line item — snapshots product/variant name & price at time of purchase
// so editing/archiving a product later never rewrites order history.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  // Snapshots — do not join to live product name/price for historical orders
  productNameSnapshot String
  variantNameSnapshot String?
  unitPrice           Decimal @db.Decimal(10, 2)
  quantity            Int
  total               Decimal @db.Decimal(10, 2)
}

// ------------------------------------------------------------
// COUPON
// ------------------------------------------------------------

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique // مثال: FATE10
  type            CouponType
  value           Decimal    @db.Decimal(10, 2) // نسبة % أو مبلغ ثابت بالـ₪ حسب type
  minOrderAmount  Decimal?   @db.Decimal(10, 2)
  startDate       DateTime?
  endDate         DateTime?
  usageLimit      Int?
  usageCount      Int        @default(0)
  isActive        Boolean    @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// HOMEPAGE CONTENT MANAGEMENT
// ------------------------------------------------------------

// Singleton row (id = "main") holding editable homepage sections.
model HomepageContent {
  id String @id @default("main")

  // Hero
  heroImageUrl      String?
  heroTitle         String  @default("اكتشفي جمالكِ بطريقتك")
  heroSubtitle      String  @default("مكياج فاخر مصمم ليمنحكِ إطلالة لا تُنسى.")
  heroPrimaryLabel  String  @default("تسوقي الآن")
  heroPrimaryUrl    String  @default("/shop")
  heroSecondaryLabel String @default("اكتشفي المجموعة")
  heroSecondaryUrl  String  @default("/shop")

  // Promo banner
  promoText   String  @default("توصيل سريع • منتجات أصلية • تجربة تسوق فاخرة")
  promoActive Boolean @default(true)

  // Brand statement
  statementText     String? @db.Text
  statementImageUrl String?
  statementActive   Boolean @default(true)

  // Instagram section
  instagramTitle  String  @default("تابعينا على Instagram")
  instagramActive Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model FeaturedCategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  imageUrl   String?
  sortOrder  Int      @default(0)
}

model InstagramImage {
  id        String @id @default(cuid())
  imageUrl  String
  linkUrl   String?
  sortOrder Int    @default(0)
}

// ------------------------------------------------------------
// ADMIN
// ------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  createdAt    DateTime  @default(now())
}

// ------------------------------------------------------------
// STORE SETTINGS (singleton)
// ------------------------------------------------------------

model StoreSettings {
  id String @id @default("main")

  storeName    String  @default("FATEKIT")
  logoUrl      String?
  phone        String?
  email        String?
  whatsapp     String?

  deliveryAreas       String[] @default([]) // مناطق التوصيل
  deliveryFee         Decimal  @default(0) @db.Decimal(10, 2)
  freeShippingMinimum Decimal? @db.Decimal(10, 2)

  currency String @default("ILS") // ثابتة — ₪ فقط
  codOnly  Boolean @default(true)  // ثابتة — لا يوجد دفع إلكتروني

  updatedAt DateTime @updatedAt
}
